<Window x:Class="AdaptiveMedia.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DemiMedia" Width="1120" Height="800" MinWidth="880" MinHeight="620"
        WindowStartupLocation="CenterScreen" Style="{StaticResource Dm.Window}"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver" DragLeave="Window_DragLeave">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- App bar: product lockup on the left, quiet tools on the right. -->
        <Border Background="{StaticResource Dm.Chrome}" BorderBrush="{StaticResource Dm.SeparatorChrome}" BorderThickness="0,0,0,1" Padding="24,0" Height="56">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="DemiMedia" FontFamily="{StaticResource Dm.FontDisplay}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Dm.TextStrong}"/>
                    <TextBlock Text="by Allusions" FontSize="12" Foreground="{StaticResource Dm.TextSecondary}" Margin="10,0,0,1" VerticalAlignment="Bottom"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource Dm.Pill}" CornerRadius="5" Padding="8,3" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="Development build" FontSize="11" Foreground="{StaticResource Dm.TextSecondary}"/>
                    </Border>
                    <ToggleButton x:Name="DetailsToggle" Content="Playback _details" Style="{StaticResource Dm.ToolToggle}" Margin="0,0,8,0" Visibility="Collapsed"
                                  Checked="DetailsToggle_Changed" Unchecked="DetailsToggle_Changed"
                                  AutomationProperties.HelpText="Show what was requested, planned and observed for this playback"/>
                    <Button x:Name="SettingsButton" Content="_Settings" Style="{StaticResource Dm.ToolButton}" Click="Settings_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" Focusable="False">
                <!-- Centred while there is only the open prompt; top-aligned once media is chosen. -->
                <StackPanel x:Name="Page" MaxWidth="1000" Margin="56,40,56,72" VerticalAlignment="Center">

                    <Border x:Name="SettingsWarning" Visibility="Collapsed" Background="{StaticResource Dm.WarnSurface}" CornerRadius="9" Padding="16,12" Margin="0,0,0,28">
                        <TextBlock x:Name="SettingsWarningText" TextWrapping="Wrap" Foreground="{StaticResource Dm.WarnText}" FontSize="12.5" AutomationProperties.LiveSetting="Polite"/>
                    </Border>

                    <!-- Hero: an honest entry when nothing is chosen, the chosen media once it is. -->
                    <Grid x:Name="Hero">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition x:Name="DropColumn" Width="300"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,48,0" VerticalAlignment="Center">
                            <TextBlock x:Name="HeroEyebrow" Style="{StaticResource Dm.Label}" Margin="0,0,0,12" Visibility="Collapsed"/>
                            <TextBlock x:Name="HeroTitle" Style="{StaticResource Dm.Headline}" Text="Open a film. The rest can wait." MaxWidth="640" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="HeroBody" Style="{StaticResource Dm.Body}" Margin="0,16,0,0" MaxWidth="520" HorizontalAlignment="Left" FontSize="14"
                                       Text="A file, a folder or a stream. The picture takes the screen; the detail waits one step away."/>
                            <TextBlock x:Name="SelectedMediaText" Style="{StaticResource Dm.Machine}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"
                                       Visibility="Collapsed" AutomationProperties.Name="Selected media"/>

                            <StackPanel x:Name="PlayRow" Orientation="Horizontal" Margin="0,32,0,0" Visibility="Collapsed">
                                <Button x:Name="PlayButton" Content="_Play" Style="{StaticResource Dm.PlayButton}" Click="Play_Click" IsEnabled="False"
                                        AutomationProperties.Name="Play" AutomationProperties.HelpText="Start the playback plan shown below"/>
                                <Button x:Name="StartBeginningButton" Content="Start from _beginning" Style="{StaticResource Dm.GhostButton}"
                                        Click="StartBeginning_Click" Visibility="Collapsed" Margin="10,0,0,0"
                                        AutomationProperties.Name="Start from beginning"/>
                                <TextBlock x:Name="StatusText" Text="Ready" Style="{StaticResource Dm.Body}" Margin="18,0,0,0" VerticalAlignment="Center"
                                           MaxWidth="440" AutomationProperties.LiveSetting="Polite"/>
                            </StackPanel>

                            <StackPanel x:Name="MediaActions" Orientation="Horizontal" Margin="0,32,0,0">
                                <Button x:Name="OpenFileButton" Content="Open _file" Style="{StaticResource Dm.PrimaryButton}" Click="OpenFiles_Click"
                                        ToolTip="Ctrl+O"/>
                                <Button x:Name="OpenFolderButton" Content="Open f_older" Click="OpenFolder_Click" Margin="10,0,0,0"/>
                                <Button x:Name="OpenUrlButton" Content="Open _URL" Click="OpenUrl_Click" Margin="10,0,0,0" ToolTip="Ctrl+U"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- The whole window accepts a drop. This plane is where people look for it;
                             it draws an outline only while something is dragged over the window. -->
                        <Grid x:Name="DropZone" Grid.Column="1" MinHeight="200" VerticalAlignment="Center">
                            <Border x:Name="DropSurface" Background="{StaticResource Dm.SurfaceDrop}" CornerRadius="14"/>
                            <Rectangle x:Name="DropOutline" RadiusX="14" RadiusY="14" Stroke="Transparent" StrokeThickness="1.2" StrokeDashArray="5 4"/>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                                <Path Data="M 12,2 L 12,15 M 6.5,9.5 L 12,15 L 17.5,9.5 M 3,19 L 21,19" Stroke="{StaticResource Dm.TextMuted}" StrokeThickness="1.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                                <TextBlock x:Name="DropTitle" Text="Drop a video here" FontSize="14" Foreground="{StaticResource Dm.TextHeading}" HorizontalAlignment="Center"/>
                                <TextBlock Text="It plays from this PC." Style="{StaticResource Dm.Meta}" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Shown only when the player reports a condition that persists or fails. -->
                    <Border x:Name="AttentionCard" Visibility="Collapsed" Margin="0,36,0,0" Background="{StaticResource Dm.AttentionSurface}"
                            BorderBrush="{StaticResource Dm.AttentionBorder}" BorderThickness="1" CornerRadius="10" Padding="18,15" MaxWidth="620" HorizontalAlignment="Left">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Playback needs attention" FontWeight="SemiBold" Foreground="{StaticResource Dm.AttentionTitle}"/>
                                <TextBlock x:Name="AttentionText" TextWrapping="Wrap" Foreground="{StaticResource Dm.AttentionText}" FontSize="12.5" Margin="0,4,0,0"
                                           AutomationProperties.LiveSetting="Assertive"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Inspect details" Style="{StaticResource Dm.ToolButton}" Margin="16,0,0,0" VerticalAlignment="Center"
                                    Click="InspectDetails_Click"/>
                        </Grid>
                    </Border>

                    <!-- Intent: what the viewer wants, in their words. DemiMedia turns it into a plan. -->
                    <StackPanel x:Name="PlaybackChoices" Visibility="Collapsed" Margin="0,88,0,0">
                        <TextBlock Text="How should this look?" Style="{StaticResource Dm.Section}"/>

                        <ListBox x:Name="ProfileBox" Style="{StaticResource Dm.Rail}" SelectedIndex="0" Margin="0,24,0,0" AutomationProperties.Name="Enhancement mode">
                            <ListBoxItem Content="Automatic" Tag="Automatic" ToolTip="Describe the result you want and let DemiMedia choose the supported path."/>
                            <ListBoxItem Content="Reference" Tag="Reference" ToolTip="Preserve source cadence and colour intent; avoid optional processing."/>
                            <ListBoxItem Content="Enhanced" Tag="Enhanced" ToolTip="Choose detail, motion, cleanup, and performance independently."/>
                            <ListBoxItem Content="Compatibility" Tag="Compatibility" ToolTip="Use the fallback playback path for troublesome files or drivers."/>
                        </ListBox>
                        <TextBlock x:Name="ModeExplanation" Style="{StaticResource Dm.Meta}" FontSize="12.5" Margin="0,12,0,0" MaxWidth="620" HorizontalAlignment="Left"/>

                        <!-- One composed choice: the results as a column, the chosen one explained beside it. -->
                        <Grid x:Name="AutomaticChoices" Margin="0,40,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="GoalColumn" Width="380"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ListBox x:Name="AutomaticGoalBox" Style="{StaticResource Dm.GoalList}" AutomationProperties.Name="What matters most" Margin="-22,0,0,0">
                                <ListBoxItem Content="Preserve the original look" Tag="PreserveOriginal"
                                             AutomationProperties.HelpText="The picture as it was authored. Nothing discretionary is added."/>
                                <ListBoxItem Content="Improve detail" Tag="ImproveDetail"
                                             AutomationProperties.HelpText="Sharper scaling when the source is smaller than your screen."/>
                                <ListBoxItem Content="Make motion smoother" Tag="SmootherMotion"
                                             AutomationProperties.HelpText="Blends neighbouring frames. This is not generated or AI motion."/>
                                <ListBoxItem Content="Clean up compression and banding" Tag="CleanImage"
                                             AutomationProperties.HelpText="Smooths gradients and blocking in heavily compressed video."/>
                                <ListBoxItem Content="Balanced improvement" Tag="BalancedImprovement"
                                             AutomationProperties.HelpText="A little of each, only where this source benefits."/>
                            </ListBox>
                            <StackPanel x:Name="GoalDetail" Grid.Column="1" Margin="8,8,0,0">
                                <TextBlock x:Name="GoalExplanation" FontFamily="{StaticResource Dm.FontDisplay}" FontSize="16" Foreground="{StaticResource Dm.Text}"
                                           TextWrapping="Wrap" MaxWidth="400" HorizontalAlignment="Left" LineStackingStrategy="BlockLineHeight" LineHeight="24"/>
                                <TextBlock Text="Strength" Style="{StaticResource Dm.Label}" Margin="0,34,0,4"/>
                                <ListBox x:Name="AutomaticStrengthBox" Style="{StaticResource Dm.Rail}" AutomationProperties.Name="Automatic enhancement strength">
                                    <ListBoxItem Content="Subtle" Tag="Subtle"/>
                                    <ListBoxItem Content="Normal" Tag="Normal"/>
                                    <ListBoxItem Content="Strong" Tag="Strong"/>
                                </ListBox>
                                <StackPanel x:Name="AutomaticPerformanceRow" Margin="0,24,0,0">
                                    <TextBlock Text="Performance" Style="{StaticResource Dm.Label}" Margin="0,0,0,4"/>
                                    <ListBox x:Name="AutomaticPerformanceBox" Style="{StaticResource Dm.Rail}" AutomationProperties.Name="Automatic performance preference">
                                        <ListBoxItem Content="Efficient" Tag="Efficient"/>
                                        <ListBoxItem Content="Balanced" Tag="Balanced"/>
                                        <ListBoxItem Content="Maximum quality" Tag="MaximumQuality"/>
                                    </ListBox>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="EnhancedChoices" Margin="0,40,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Detail" Style="{StaticResource Dm.Label}" VerticalAlignment="Center" Margin="0,0,0,22"/>
                            <ListBox x:Name="EnhancedDetailBox" Grid.Column="1" Style="{StaticResource Dm.Rail}" Margin="0,0,0,22" AutomationProperties.Name="Enhanced detail preference">
                                <ListBoxItem Content="Preserve" Tag="Preserve"/>
                                <ListBoxItem Content="Balanced" Tag="Balanced"/>
                                <ListBoxItem Content="Sharper" Tag="Sharper"/>
                                <ListBoxItem Content="Maximum" Tag="Maximum"/>
                                <ListBoxItem Content="Automatic" Tag="Automatic"/>
                            </ListBox>
                            <TextBlock Grid.Row="1" Text="Motion" Style="{StaticResource Dm.Label}" VerticalAlignment="Center" Margin="0,0,0,22"/>
                            <ListBox x:Name="EnhancedMotionBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource Dm.Rail}" Margin="0,0,0,22" AutomationProperties.Name="Enhanced motion preference">
                                <ListBoxItem Content="Original" Tag="Original" ToolTip="Preserve the source's temporal samples."/>
                                <ListBoxItem Content="Correct cadence" Tag="CadenceCorrected" ToolTip="Correct display cadence without blending neighbouring frames."/>
                                <ListBoxItem Content="Smoother motion" Tag="BlendSmooth" ToolTip="Blend neighbouring frames for smoother motion. This is not generated or AI motion."/>
                            </ListBox>
                            <TextBlock Grid.Row="2" Text="Cleanup" Style="{StaticResource Dm.Label}" VerticalAlignment="Center" Margin="0,0,0,22"/>
                            <ListBox x:Name="EnhancedCleanupBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource Dm.Rail}" Margin="0,0,0,22" AutomationProperties.Name="Enhanced cleanup preference">
                                <ListBoxItem Content="Preserve texture" Tag="PreserveTexture"/>
                                <ListBoxItem Content="Balanced" Tag="Balanced"/>
                                <ListBoxItem Content="Clean" Tag="Clean"/>
                                <ListBoxItem Content="Automatic" Tag="Automatic"/>
                            </ListBox>
                            <TextBlock Grid.Row="3" Text="Performance" Style="{StaticResource Dm.Label}" VerticalAlignment="Center"/>
                            <ListBox x:Name="EnhancedPerformanceBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource Dm.Rail}" AutomationProperties.Name="Enhanced performance preference">
                                <ListBoxItem Content="Efficient" Tag="Efficient"/>
                                <ListBoxItem Content="Balanced" Tag="Balanced"/>
                                <ListBoxItem Content="Maximum quality" Tag="MaximumQuality"/>
                            </ListBox>
                            <TextBlock Grid.Row="4" Text="Fit" Style="{StaticResource Dm.Label}" VerticalAlignment="Center"/>
                            <ListBox x:Name="EnhancedFitBox" Grid.Row="4" Grid.Column="1" Style="{StaticResource Dm.Rail}" AutomationProperties.Name="Enhanced fit preference">
                                <ListBoxItem Content="Original" Tag="Original" ToolTip="Show the authored frame without cropping."/>
                                <ListBoxItem Content="Smart Fill" Tag="SmartFill" ToolTip="Crop and gently reframe source pixels to reduce bars; never generates pixels. Experimental."/>
                            </ListBox>
                        </Grid>

                        <CheckBox x:Name="RememberCheck" Content="Remember these playback choices as my defaults" Margin="0,40,0,0" HorizontalAlignment="Left"
                                  Foreground="{StaticResource Dm.TextSecondary}"/>
                    </StackPanel>

                    <!-- The plan in plain words. Technical evidence lives in Playback details. -->
                    <StackPanel x:Name="PlanSection" Visibility="Collapsed" Margin="0,72,0,0">
                        <TextBlock Text="The plan" Style="{StaticResource Dm.Section}" FontSize="20"/>
                        <TextBlock x:Name="PlanText" Text="Choose media to see which playback choices can be used." TextWrapping="Wrap" Margin="0,14,0,0"
                                   Foreground="{StaticResource Dm.TextSecondary}" FontSize="13" LineStackingStrategy="BlockLineHeight" LineHeight="21"
                                   MaxWidth="680" HorizontalAlignment="Left" AutomationProperties.LiveSetting="Polite"/>
                        <Button Content="What was requested, planned and observed" Style="{StaticResource Dm.GhostButton}" HorizontalAlignment="Left"
                                Margin="-10,12,0,0" Click="InspectDetails_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Playback details: requested, planned, observed, health and recovery, on demand. -->
            <Border x:Name="DetailsDrawer" Grid.Column="1" Width="392" Visibility="Collapsed" Background="{StaticResource Dm.Surface}"
                    BorderBrush="{StaticResource Dm.BorderPanel}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border BorderBrush="{StaticResource Dm.BorderPanel}" BorderThickness="0,0,0,1" Padding="24,22,20,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Playback details" Style="{StaticResource Dm.Title}" FontSize="18"/>
                                <TextBlock x:Name="DetailsSubtitle" Style="{StaticResource Dm.Meta}" Margin="0,5,0,0" FontSize="11.5"
                                           Text="What you asked for, what DemiMedia planned, and what the player reported."/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Close" Style="{StaticResource Dm.ToolButton}" VerticalAlignment="Top" Click="CloseDetails_Click"
                                    AutomationProperties.Name="Close playback details"/>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel Margin="24,0,24,28">
                            <TextBlock Text="ACTIVITY" Style="{StaticResource Dm.Caps}" Margin="0,20,0,8"/>
                            <TextBlock x:Name="RuntimeText" Text="Playback has not started. Driver activity is checked during playback where observable."
                                       TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Dm.Text}" LineStackingStrategy="BlockLineHeight" LineHeight="18"
                                       AutomationProperties.LiveSetting="Polite"/>
                            <StackPanel x:Name="DetailsHost" AutomationProperties.Name="Intent, requested, planned, observed, health and recovery for this playback"/>
                            <TextBlock Text="THIS PC" Style="{StaticResource Dm.Caps}" Margin="0,26,0,8"/>
                            <TextBlock x:Name="SystemText" Text="Detecting hardware and display state…" TextWrapping="Wrap" FontSize="11.5"
                                       Foreground="{StaticResource Dm.TextSecondary}" LineStackingStrategy="BlockLineHeight" LineHeight="18"/>
                            <TextBlock Text="DIAGNOSTICS" Style="{StaticResource Dm.Caps}" Margin="0,26,0,6"/>
                            <WrapPanel Margin="-10,0,0,0">
                                <Button Content="Copy diagnostics" Style="{StaticResource Dm.GhostButton}" Click="CopyDiagnostics_Click"/>
                                <Button Content="Diagnostics folder" Style="{StaticResource Dm.GhostButton}" Click="Diagnostics_Click"/>
                            </WrapPanel>
                            <TextBlock x:Name="DiagnosticsStatusText" Style="{StaticResource Dm.Meta}" Margin="0,2,0,0" AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
