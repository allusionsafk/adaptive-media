<Window x:Class="AdaptiveMedia.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DemiMedia" Width="980" Height="720" MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" Padding="32,24">
            <StackPanel>
                <TextBlock Text="DemiMedia" Foreground="White" FontSize="34" FontWeight="SemiBold"/>
                <TextBlock Text="Choose media, review your playback plan, then press Play." Foreground="#D7DBE2" FontSize="14" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28">
                <Grid x:Name="MediaActions">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Height="60" FontSize="15" FontWeight="SemiBold" Click="OpenFiles_Click">Choose _files</Button>
                    <Button Grid.Column="2" Height="60" FontSize="15" FontWeight="SemiBold" Click="OpenFolder_Click">Choose f_older</Button>
                    <Button Grid.Column="4" Height="60" FontSize="15" FontWeight="SemiBold" Click="OpenUrl_Click">Choose _URL</Button>
                </Grid>
                <TextBlock Text="Or drop files or a folder here to prepare a plan." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="2,12,0,12"/>
                <TextBlock x:Name="SelectedMediaText" Text="No media selected" TextWrapping="Wrap" Margin="2,0,0,18" FontWeight="SemiBold"/>

                <Border Background="{StaticResource CardBrush}" BorderBrush="#D7DCE3" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel x:Name="PlaybackChoices">
                        <TextBlock Text="How should this look?" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="Choose the result you want. DemiMedia will select and explain the playback path."
                                   TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Mode" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <ComboBox AutomationProperties.Name="Enhancement mode" x:Name="ProfileBox" Grid.Column="1" SelectedIndex="0">
                                <ComboBoxItem Content="Automatic" ToolTip="Describe the result you want and let DemiMedia choose the supported path."/>
                                <ComboBoxItem Content="Reference" ToolTip="Preserve source cadence and colour intent; avoid optional processing."/>
                                <ComboBoxItem Content="Enhanced" ToolTip="Choose detail, motion, cleanup, and performance independently."/>
                                <ComboBoxItem Content="Compatibility" ToolTip="Use the fallback playback path for troublesome files or drivers."/>
                            </ComboBox>
                        </Grid>

                        <Grid x:Name="AutomaticChoices" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Priority" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <ComboBox x:Name="AutomaticGoalBox" Grid.Column="1" AutomationProperties.Name="What matters most">
                                <ComboBoxItem Content="Preserve the original look" Tag="PreserveOriginal"/>
                                <ComboBoxItem Content="Improve detail" Tag="ImproveDetail"/>
                                <ComboBoxItem Content="Make motion smoother" Tag="SmootherMotion"/>
                                <ComboBoxItem Content="Clean up compression and banding" Tag="CleanImage"/>
                                <ComboBoxItem Content="Balanced improvement" Tag="BalancedImprovement"/>
                            </ComboBox>
                            <TextBlock Grid.Column="3" Text="Strength" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <ComboBox x:Name="AutomaticStrengthBox" Grid.Column="4" AutomationProperties.Name="Automatic enhancement strength">
                                <ComboBoxItem Content="Subtle" Tag="Subtle"/>
                                <ComboBoxItem Content="Normal" Tag="Normal"/>
                                <ComboBoxItem Content="Strong" Tag="Strong"/>
                            </ComboBox>
                        </Grid>

                        <Grid x:Name="AutomaticPerformanceRow" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Performance" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <ComboBox x:Name="AutomaticPerformanceBox" Grid.Column="1" AutomationProperties.Name="Automatic performance preference">
                                <ComboBoxItem Content="Efficient" Tag="Efficient"/>
                                <ComboBoxItem Content="Balanced" Tag="Balanced"/>
                                <ComboBoxItem Content="Maximum quality" Tag="MaximumQuality"/>
                            </ComboBox>
                        </Grid>

                        <Grid x:Name="EnhancedChoices" Margin="0,16,0,0" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Detail" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <ComboBox x:Name="EnhancedDetailBox" Grid.Column="1" AutomationProperties.Name="Enhanced detail preference">
                                <ComboBoxItem Content="Preserve" Tag="Preserve"/>
                                <ComboBoxItem Content="Balanced" Tag="Balanced"/>
                                <ComboBoxItem Content="Sharper" Tag="Sharper"/>
                                <ComboBoxItem Content="Maximum" Tag="Maximum"/>
                                <ComboBoxItem Content="Automatic" Tag="Automatic"/>
                            </ComboBox>
                            <TextBlock Grid.Column="3" Text="Motion" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <ComboBox x:Name="EnhancedMotionBox" Grid.Column="4" AutomationProperties.Name="Enhanced motion preference">
                                <ComboBoxItem Content="Original" Tag="Original" ToolTip="Preserve the source's temporal samples."/>
                                <ComboBoxItem Content="Correct cadence" Tag="CadenceCorrected" ToolTip="Correct display cadence without blending neighbouring frames."/>
                                <ComboBoxItem Content="Smoother motion" Tag="BlendSmooth" ToolTip="Blend neighbouring frames for smoother motion. This is not generated or AI motion."/>
                            </ComboBox>
                            <TextBlock Grid.Row="1" Text="Cleanup" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,12,0,0"/>
                            <ComboBox x:Name="EnhancedCleanupBox" Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" AutomationProperties.Name="Enhanced cleanup preference">
                                <ComboBoxItem Content="Preserve texture" Tag="PreserveTexture"/>
                                <ComboBoxItem Content="Balanced" Tag="Balanced"/>
                                <ComboBoxItem Content="Clean" Tag="Clean"/>
                                <ComboBoxItem Content="Automatic" Tag="Automatic"/>
                            </ComboBox>
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="Performance" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,12,0,0"/>
                            <ComboBox x:Name="EnhancedPerformanceBox" Grid.Row="1" Grid.Column="4" Margin="0,12,0,0" AutomationProperties.Name="Enhanced performance preference">
                                <ComboBoxItem Content="Efficient" Tag="Efficient"/>
                                <ComboBoxItem Content="Balanced" Tag="Balanced"/>
                                <ComboBoxItem Content="Maximum quality" Tag="MaximumQuality"/>
                            </ComboBox>
                        </Grid>

                        <TextBlock x:Name="ModeExplanation" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0"/>
                        <CheckBox x:Name="RememberCheck" Content="Remember these playback choices as my defaults" Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBrush}" BorderBrush="#D7DCE3" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,18,0,0">
                    <StackPanel>
                        
                        
                        <TextBlock Text="Playback plan" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="PlanText" Text="Choose media to see which playback choices can be used." TextWrapping="Wrap" Margin="0,10,0,14" AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock x:Name="SettingsWarningText" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,14" Foreground="#984B00" AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock Text="Playback activity" FontWeight="SemiBold"/>
                        <TextBlock x:Name="RuntimeText" Text="Playback has not started. Driver activity is checked during playback where observable." TextWrapping="Wrap" Margin="0,6,0,16" AutomationProperties.LiveSetting="Polite"/>
                        <Expander x:Name="TruthExpander" Header="Playback details" Visibility="Collapsed" Margin="0,0,0,12" Expanded="TruthExpander_Expanded">
                        <TextBlock x:Name="TruthText" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" AutomationProperties.Name="Intent, requested, planned, observed, health and recovery for this playback"/></Expander>
                        <Expander Header="System details">
                        <TextBlock x:Name="SystemText" Text="Detecting hardware and display state…" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/></Expander>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="#D7DCE3" BorderThickness="0,1,0,0" Padding="26,14" Background="#FAFBFC">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Development build" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,4,14,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
                <WrapPanel Grid.Column="1" MaxWidth="500" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="SettingsButton" Content="_Settings" Click="Settings_Click" Margin="0,0,10,0"/>
                    <Button Content="Copy diagnostics" Click="CopyDiagnostics_Click" Margin="0,0,10,0"/><Button Content="Diagnostics folder" Click="Diagnostics_Click" Margin="0,0,10,0"/>
                    <Button x:Name="PlayButton" Content="_Play" Click="Play_Click" IsEnabled="False" MinWidth="94" FontWeight="SemiBold" Background="{StaticResource AccentBrush}" Foreground="White" AutomationProperties.HelpText="Start the playback plan shown above"/>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</Window>




