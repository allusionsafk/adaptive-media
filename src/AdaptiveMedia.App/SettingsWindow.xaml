<Window x:Class="AdaptiveMedia.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DemiMedia Settings" Width="640" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Style="{StaticResource Dm.Window}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="32,28,32,8">
            <TextBlock Text="Settings" Style="{StaticResource Dm.Title}"/>
            <TextBlock Text="System-wide playback behaviours. Per-video enhancement choices stay on the main launcher." Style="{StaticResource Dm.Body}" Margin="0,6,0,0"/>

            <TextBlock Text="DISPLAY" Style="{StaticResource Dm.Caps}" Margin="0,28,0,4"/>
            <CheckBox x:Name="HdrCheck" Margin="0,10">
                <TextBlock Text="Automatic Windows HDR switching unavailable in this build" TextWrapping="Wrap"/>
            </CheckBox>
            <TextBlock Text="DemiMedia reads the selected display's HDR state and plans playback accordingly. It does not change Windows HDR; a safe target-bound restore is not yet qualified."
                       Style="{StaticResource Dm.Meta}" FontSize="12" Margin="30,0,0,6" TextWrapping="Wrap"/>
            <CheckBox x:Name="CinemaBoostCheck" Margin="0,10,0,4">
                <TextBlock Text="Cinema Boost: temporarily raise the matched built-in display brightness during playback" TextWrapping="Wrap"/>
            </CheckBox>
            <TextBlock Text="Only on AC power with Energy Saver off and an exactly identified internal panel. Your brightness is restored after playback unless you change it yourself."
                       Style="{StaticResource Dm.Meta}" FontSize="12" Margin="30,0,0,6" TextWrapping="Wrap"/>
            <CheckBox x:Name="ExternalCheck" Margin="0,10">
                <TextBlock Text="Prefer an external display when connected" TextWrapping="Wrap"/>
            </CheckBox>
            <CheckBox x:Name="FullscreenCheck" Margin="0,10">
                <TextBlock Text="Start fullscreen on the preferred external display" TextWrapping="Wrap"/>
            </CheckBox>

            <TextBlock Text="AUDIO" Style="{StaticResource Dm.Caps}" Margin="0,24,0,4"/>
            <CheckBox x:Name="BitstreamCheck" Margin="0,10,0,4">
                <TextBlock Text="Request AC-3 / E-AC-3 / TrueHD / DTS-HD passthrough for a receiver selected in Windows" TextWrapping="Wrap"/>
            </CheckBox>
            <TextBlock Text="DemiMedia cannot verify the HDMI path, receiver capability, or Atmos delivery. Leave this off for laptop speakers, ordinary TV speakers, Bluetooth, USB audio, or Dolby Atmos for Headphones."
                       Style="{StaticResource Dm.Meta}" FontSize="12" Margin="30,0,0,6"/>

            <TextBlock Text="FALLBACK" Style="{StaticResource Dm.Caps}" Margin="0,24,0,4"/>
            <CheckBox x:Name="MpcCheck" Margin="0,10">
                <TextBlock Text="MPC-BE fallback unavailable in this build" TextWrapping="Wrap"/>
            </CheckBox>
            <TextBlock Text="DemiMedia cannot verify and launch MPC-BE safely yet. Playback failures stay in DemiMedia's diagnostics."
                       Style="{StaticResource Dm.Meta}" FontSize="12" Margin="30,0,0,6" TextWrapping="Wrap"/>

            <TextBlock Text="EXPERIMENTAL" Style="{StaticResource Dm.Caps}" Margin="0,24,0,4"/>
            <CheckBox x:Name="NativeDvCheck" Margin="0,10,0,4">
                <TextBlock Text="Request native Dolby Vision Profile 7 enhancement-layer composition" TextWrapping="Wrap"/>
            </CheckBox>
            <TextBlock Text="Uses a separate player runtime that DemiMedia installs and verifies on its own, alongside your normal player. Ordinary playback is unaffected. Whether the enhancement layer is actually composed is reported after playback starts; it is never assumed."
                       Style="{StaticResource Dm.Meta}" FontSize="12" LineStackingStrategy="BlockLineHeight" LineHeight="18" Margin="30,0,0,8"/>
            <CheckBox x:Name="NativeDvDownloadCheck" Margin="30,4,0,10">
                <TextBlock Text="Download that runtime automatically when it is needed" TextWrapping="Wrap"/>
            </CheckBox>
        </StackPanel>
        <Border Grid.Row="1" Background="{StaticResource Dm.Chrome}" BorderBrush="{StaticResource Dm.SeparatorChrome}" BorderThickness="0,1,0,0"
                Padding="32,14" Margin="0,20,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Margin="0,0,10,0" MinWidth="96"/>
                <Button Content="Save" IsDefault="True" Click="Save_Click" Style="{StaticResource Dm.PrimaryButton}" MinWidth="96"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
