<!--
  DemiMedia visual system: a quiet cinematic ground that recedes around the media.
  Tokens follow the Allusions product-design prototype (brand-product-design/prototypes,
  product-ui.css) with two deliberate fixes: a focus ring that clears 3:1 on every dark
  ground, and a hover state that is distinct from the selected state.
  Green is semantic only (healthy, verified); it is never decoration or an action colour.
  Human labels use Segoe UI Variable; machine-produced values use the Mono family.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Grounds and surfaces -->
    <SolidColorBrush x:Key="Dm.Canvas" Color="#080B0D"/>
    <SolidColorBrush x:Key="Dm.Ground" Color="#101417"/>
    <SolidColorBrush x:Key="Dm.Chrome" Color="#151A1E"/>
    <SolidColorBrush x:Key="Dm.Surface" Color="#1B2226"/>
    <SolidColorBrush x:Key="Dm.SurfaceDrop" Color="#161D21"/>
    <SolidColorBrush x:Key="Dm.SurfaceDropActive" Color="#212B30"/>
    <SolidColorBrush x:Key="Dm.Control" Color="#252D31"/>
    <SolidColorBrush x:Key="Dm.ControlHover" Color="#323C41"/>
    <SolidColorBrush x:Key="Dm.ControlPressed" Color="#1E2529"/>
    <SolidColorBrush x:Key="Dm.Option" Color="#1F272B"/>
    <SolidColorBrush x:Key="Dm.OptionHover" Color="#28323A"/>
    <SolidColorBrush x:Key="Dm.OptionSelected" Color="#34434A"/>
    <SolidColorBrush x:Key="Dm.ToolHover" Color="#232B30"/>
    <SolidColorBrush x:Key="Dm.ToolActive" Color="#3D4A50"/>
    <SolidColorBrush x:Key="Dm.Pill" Color="#252F34"/>

    <!-- Lines -->
    <SolidColorBrush x:Key="Dm.Separator" Color="#2B3439"/>
    <SolidColorBrush x:Key="Dm.SeparatorChrome" Color="#262D32"/>
    <SolidColorBrush x:Key="Dm.BorderPanel" Color="#2E373C"/>
    <SolidColorBrush x:Key="Dm.BorderControl" Color="#4B565A"/>
    <SolidColorBrush x:Key="Dm.BorderInput" Color="#4A555B"/>
    <SolidColorBrush x:Key="Dm.BorderOption" Color="#343F44"/>
    <SolidColorBrush x:Key="Dm.BorderSelected" Color="#8A9BA3"/>
    <SolidColorBrush x:Key="Dm.BorderTool" Color="#394146"/>
    <SolidColorBrush x:Key="Dm.BorderDrop" Color="#4E5A5F"/>

    <!-- Text -->
    <SolidColorBrush x:Key="Dm.Text" Color="#E7E8E8"/>
    <SolidColorBrush x:Key="Dm.TextStrong" Color="#F3F4F4"/>
    <SolidColorBrush x:Key="Dm.TextHeading" Color="#ECEEEE"/>
    <SolidColorBrush x:Key="Dm.TextSecondary" Color="#AAB5B9"/>
    <SolidColorBrush x:Key="Dm.TextMuted" Color="#929DA3"/>
    <SolidColorBrush x:Key="Dm.TextCaps" Color="#A2B0B4"/>
    <SolidColorBrush x:Key="Dm.Link" Color="#A8C1D7"/>

    <!-- Actions -->
    <SolidColorBrush x:Key="Dm.Primary" Color="#E1E6E5"/>
    <SolidColorBrush x:Key="Dm.PrimaryHover" Color="#F4F7F6"/>
    <SolidColorBrush x:Key="Dm.PrimaryPressed" Color="#C6CFCE"/>
    <SolidColorBrush x:Key="Dm.TextOnPrimary" Color="#141A1D"/>
    <SolidColorBrush x:Key="Dm.Focus" Color="#A8C1D7"/>
    <SolidColorBrush x:Key="Dm.Selection" Color="#46607A"/>

    <!-- Semantic states. Attention is warm and quiet; healthy is green and used only
         where the player has actually reported it. -->
    <SolidColorBrush x:Key="Dm.AttentionSurface" Color="#2D2927"/>
    <SolidColorBrush x:Key="Dm.AttentionBorder" Color="#885D49"/>
    <SolidColorBrush x:Key="Dm.AttentionTitle" Color="#F6E2D0"/>
    <SolidColorBrush x:Key="Dm.AttentionText" Color="#E7D6CB"/>
    <SolidColorBrush x:Key="Dm.ErrorSurface" Color="#392B29"/>
    <SolidColorBrush x:Key="Dm.ErrorBorder" Color="#7C4E49"/>
    <SolidColorBrush x:Key="Dm.ErrorText" Color="#F1B3A8"/>
    <SolidColorBrush x:Key="Dm.Healthy" Color="#8DCC95"/>
    <SolidColorBrush x:Key="Dm.HealthyText" Color="#B4DBB7"/>
    <SolidColorBrush x:Key="Dm.HealthySurface" Color="#1F3325"/>
    <SolidColorBrush x:Key="Dm.WarnText" Color="#F4D1A7"/>
    <SolidColorBrush x:Key="Dm.WarnSurface" Color="#3A2D22"/>

    <!-- Type -->
    <FontFamily x:Key="Dm.FontUi">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Dm.FontDisplay">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Dm.FontMono">Cascadia Mono, Consolas</FontFamily>

    <!-- Focus: a 2px ring outside the control, visible on every ground. -->
    <Style x:Key="Dm.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" BorderThickness="2" CornerRadius="10" BorderBrush="{StaticResource Dm.Focus}" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Windows -->
    <Style x:Key="Dm.Window" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource Dm.Ground}"/>
        <Setter Property="Foreground" Value="{StaticResource Dm.Text}"/>
        <Setter Property="FontFamily" Value="{StaticResource Dm.FontUi}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

    <!-- Text roles -->
    <Style x:Key="Dm.Headline" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Dm.FontDisplay}"/>
        <Setter Property="FontSize" Value="46"/>
        <Setter Property="FontWeight" Value="Light"/>
        <Setter Property="Foreground" Value="{StaticResource Dm.TextHeading}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="LineHeight" Value="52"/>
    </Style>
    <Style x:Key="Dm.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Dm.FontDisplay}"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Dm.TextHeading}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Dm.Section" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Dm.FontDisplay}"/>
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="Light"/>
        <Setter Property="Foreground" Value="{StaticResource Dm.TextHeading}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Dm.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Dm.TextSecondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="LineHeight" Value="20"/>
    </Style>
    <Style x:Key="Dm.Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Dm.TextSecondary}"/>
    </Style>
    <!-- Section labels are written in capitals in the source text; WPF has no text-transform. -->
    <Style x:Key="Dm.Caps" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Dm.TextCaps}"/>
        <Setter Property="Typography.CapitalSpacing" Value="True"/>
    </Style>
    <Style x:Key="Dm.Meta" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource Dm.TextMuted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Dm.Machine" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Dm.FontMono}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{StaticResource Dm.TextMuted}"/>
    </Style>

    <!-- Buttons -->
    <Style x:Key="Dm.ButtonBase" TargetType="ButtonBase">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Dm.FocusVisual}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontFamily" Value="{StaticResource Dm.FontUi}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Padding" Value="18,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{StaticResource Dm.Control}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Dm.BorderControl}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource Dm.TextStrong}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter RecognizesAccessKey="True" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.42"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Dm.ControlHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Dm.ControlPressed}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Dm.SecondaryButton" TargetType="Button" BasedOn="{StaticResource Dm.ButtonBase}"/>
    <Style TargetType="Button" BasedOn="{StaticResource Dm.SecondaryButton}"/>

    <Style x:Key="Dm.PrimaryButton" TargetType="Button" BasedOn="{StaticResource Dm.ButtonBase}">
        <Setter Property="Background" Value="{StaticResource Dm.Primary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Dm.Primary}"/>
        <Setter Property="Foreground" Value="{StaticResource Dm.TextOnPrimary}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Dm.PrimaryHover}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Dm.PrimaryHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Dm.PrimaryPressed}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Dm.PrimaryPressed}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Dm.PlayButton" TargetType="Button" BasedOn="{StaticResource Dm.PrimaryButton}">
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="MinWidth" Value="132"/>
        <Setter Property="Padding" Value="26,0"/>
        <Setter Property="FontSize" Value="15"/>
    </Style>

    <!-- Quiet chrome buttons for the app bar and panels. -->
    <Style x:Key="Dm.ToolBase" TargetType="ButtonBase" BasedOn="{StaticResource Dm.ButtonBase}">
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource Dm.BorderTool}"/>
        <Setter Property="Foreground" Value="{StaticResource Dm.Text}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Dm.ToolHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Dm.ControlPressed}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Dm.ToolButton" TargetType="Button" BasedOn="{StaticResource Dm.ToolBase}"/>
    <Style x:Key="Dm.ToolToggle" TargetType="ToggleButton" BasedOn="{StaticResource Dm.ToolBase}">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource Dm.ToolActive}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Dm.ToolActive}"/>
                <Setter Property="Foreground" Value="{StaticResource Dm.TextStrong}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Text-weight action with no border, for secondary actions inside panels. -->
    <Style x:Key="Dm.GhostButton" TargetType="Button" BasedOn="{StaticResource Dm.ButtonBase}">
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Dm.Link}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Dm.ToolHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Choice rails. Built on ListBox so each option keeps a stable Tag value, arrow-key
         navigation and a UI Automation selection pattern. Options are words on a hairline;
         the chosen one brightens and gains a marker underneath.
         Feline signature (one of two in DemiMedia): the marker begins with a tiny pair of
         ears. It is meant to be noticed late, never announced. -->
    <Style x:Key="Dm.RailItem" TargetType="ListBoxItem">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Dm.FocusVisual}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource Dm.TextMuted}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="0,0,26,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Background="Transparent" MinHeight="36">
                        <ContentPresenter VerticalAlignment="Center" Margin="0,0,0,8" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        <Grid x:Name="Marker" VerticalAlignment="Bottom" Visibility="Hidden" SnapsToDevicePixels="True">
                            <Rectangle Height="2" VerticalAlignment="Bottom" Fill="{StaticResource Dm.Primary}"/>
                            <Path Data="M 0,4 L 2,0.5 L 4,4 Z M 5,4 L 7,0.5 L 9,4 Z" Fill="{StaticResource Dm.Primary}"
                                  HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,1.5"/>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Dm.Text}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Dm.TextStrong}"/>
                            <Setter TargetName="Marker" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Dm.Rail" TargetType="ListBox">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle"/>
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Once"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource Dm.RailItem}"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Grid>
                        <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{StaticResource Dm.Separator}" Margin="0,0,-26,0"/>
                        <ItemsPresenter/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The result list: one composed column. The chosen result is set large and bright;
         the others stay quiet until pointed at. -->
    <Style x:Key="Dm.GoalItem" TargetType="ListBoxItem">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Dm.FocusVisual}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource Dm.TextMuted}"/>
        <Setter Property="FontFamily" Value="{StaticResource Dm.FontDisplay}"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Background="Transparent" Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle x:Name="Marker" Width="2" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Fill="{StaticResource Dm.Primary}" Visibility="Hidden"/>
                        <ContentPresenter Grid.Column="1" Margin="0,7" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Dm.Text}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Dm.TextStrong}"/>
                            <Setter Property="FontSize" Value="22"/>
                            <Setter TargetName="Marker" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Dm.GoalList" TargetType="ListBox">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle"/>
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Once"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource Dm.GoalItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <StackPanel IsItemsHost="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Check box -->
    <Style TargetType="CheckBox">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Dm.FocusVisual}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource Dm.Text}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="5" BorderThickness="1.5" VerticalAlignment="Top" Margin="0,1,0,0"
                                Background="{StaticResource Dm.Control}" BorderBrush="{StaticResource Dm.BorderSelected}">
                            <Path x:Name="Tick" Data="M 3.5,8.5 L 6.8,11.8 L 12.8,4.8" Stroke="{StaticResource Dm.TextOnPrimary}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="12,0,0,0" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Dm.Primary}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Dm.Primary}"/>
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Dm.TextStrong}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text entry -->
    <Style TargetType="TextBox">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="{StaticResource Dm.Canvas}"/>
        <Setter Property="Foreground" Value="{StaticResource Dm.TextStrong}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Dm.BorderInput}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Dm.TextStrong}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Dm.Selection}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="8" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Dm.Focus}"/>
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Drop-down (used for stream quality) -->
    <Style x:Key="Dm.ComboToggle" TargetType="ToggleButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="ClickMode" Value="Press"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome" Background="{StaticResource Dm.Control}" BorderBrush="{StaticResource Dm.BorderInput}"
                            BorderThickness="1" CornerRadius="8" SnapsToDevicePixels="True">
                        <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" Data="M 0,0 L 5,5 L 10,0"
                              Stroke="{StaticResource Dm.TextSecondary}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Dm.ControlHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="{StaticResource Dm.Text}"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Dm.ControlHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Dm.OptionSelected}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Dm.FocusVisual}"/>
        <Setter Property="Foreground" Value="{StaticResource Dm.TextStrong}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource Dm.ComboToggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter IsHitTestVisible="False" Margin="14,0,36,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                               PopupAnimation="Fade" VerticalOffset="4">
                            <Border Background="{StaticResource Dm.Surface}" BorderBrush="{StaticResource Dm.BorderPanel}" BorderThickness="1"
                                    CornerRadius="9" Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Scroll bars: thin and quiet until needed. -->
    <Style x:Key="Dm.ScrollThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Grip" Background="#3A4449" CornerRadius="4"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Grip" Property="Background" Value="#56636A"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Grip" Property="Background" Value="#6B7980"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2,4">
                        <Track.Thumb>
                            <Thumb Style="{StaticResource Dm.ScrollThumb}"/>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="False" Margin="4,2">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource Dm.ScrollThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource Dm.Surface}" BorderBrush="{StaticResource Dm.BorderControl}" BorderThickness="1"
                            CornerRadius="7" Padding="11,8" MaxWidth="340">
                        <ContentPresenter TextElement.Foreground="{StaticResource Dm.Text}" TextElement.FontSize="12"
                                          TextElement.FontFamily="{StaticResource Dm.FontUi}">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Status pills for evidence rows: text says the state, colour only reinforces it. -->
    <Style x:Key="Dm.PillBox" TargetType="Border">
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Padding" Value="7,3"/>
        <Setter Property="Background" Value="{StaticResource Dm.Pill}"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
</ResourceDictionary>
