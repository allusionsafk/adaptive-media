<Window x:Class="AdaptiveMedia.UrlDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open URL / stream" Width="600" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Style="{StaticResource Dm.Window}" FocusManager.FocusedElement="{Binding ElementName=UrlBox}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="32,28,32,8">
            <TextBlock Text="Network media" Style="{StaticResource Dm.Title}"/>
            <TextBlock Text="Direct media URLs and yt-dlp-supported web pages are accepted." Style="{StaticResource Dm.Body}" Margin="0,6,0,20"/>
            <TextBlock Text="ADDRESS" Style="{StaticResource Dm.Caps}" Margin="0,0,0,8"/>
            <TextBox x:Name="UrlBox" AutomationProperties.Name="Media address" FontFamily="{StaticResource Dm.FontMono}" FontSize="13"/>
            <TextBlock Text="QUALITY" Style="{StaticResource Dm.Caps}" Margin="0,20,0,8"/>
            <ComboBox x:Name="QualityBox" Width="240" HorizontalAlignment="Left" SelectedIndex="0" AutomationProperties.Name="Stream quality">
                <ComboBoxItem Content="Best available" Tag="bestvideo+bestaudio/best"/>
                <ComboBoxItem Content="Up to 4K" Tag="bestvideo[height&lt;=2160]+bestaudio/best[height&lt;=2160]"/>
                <ComboBoxItem Content="Up to 1440p" Tag="bestvideo[height&lt;=1440]+bestaudio/best[height&lt;=1440]"/>
                <ComboBoxItem Content="Up to 1080p" Tag="bestvideo[height&lt;=1080]+bestaudio/best[height&lt;=1080]"/>
            </ComboBox>
        </StackPanel>
        <Border Grid.Row="1" Background="{StaticResource Dm.Chrome}" BorderBrush="{StaticResource Dm.SeparatorChrome}" BorderThickness="0,1,0,0"
                Padding="32,14" Margin="0,24,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Margin="0,0,10,0" MinWidth="96"/>
                <Button Content="Open" IsDefault="True" Click="Play_Click" Style="{StaticResource Dm.PrimaryButton}" MinWidth="96"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
