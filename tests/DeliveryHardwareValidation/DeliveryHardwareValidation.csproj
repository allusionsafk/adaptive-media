<Project Sdk="Microsoft.NET.Sdk">
  <!-- Real-hardware delivery validation. Drives the production PlaybackService
       against a real mpv and GPU; run by tests/Test-EnhancementDeliveryHardware.ps1,
       never by the portable validation gate. -->
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/AdaptiveMedia.App/DvConversion*.cs" />
    <Compile Include="../../src/AdaptiveMedia.App/NativeDvPlayback.cs" />
    <Compile Include="../../src/AdaptiveMedia.App/NativeDvRuntimeStore.cs" />
    <Compile Include="../../src/AdaptiveMedia.App/NativeDvLane.cs" />
    <Compile Include="../../src/AdaptiveMedia.App/NativeDvRuntimeLifecycle.cs" />
    <Compile Include="../../src/AdaptiveMedia.App/NativeDvPlaybackHealth.cs" />
    <Compile Include="../../src/AdaptiveMedia.App/NativeProcess.cs" />
    <Compile Include="../../src/AdaptiveMedia.App/MpvIpc.cs" />
    <Compile Include="../../src/AdaptiveMedia.App/SettingsStore.cs" />
    <Compile Include="../../src/AdaptiveMedia.App/PlaybackPlan.cs" />
    <Compile Include="../../src/AdaptiveMedia.App/EnhancementPlanning.cs" />
    <Compile Include="../../src/AdaptiveMedia.App/Models.cs" />
    <Compile Include="../../src/AdaptiveMedia.App/PlaybackService.cs" />
    <Compile Include="../../src/AdaptiveMedia.App/PlaybackHealth.cs" />
    <Compile Include="../../src/AdaptiveMedia.App/PlaybackHealthMonitor.cs" />
    <Compile Include="../../src/AdaptiveMedia.App/PlaybackRecovery.cs" />
    <Compile Include="../../src/AdaptiveMedia.App/PlaybackTruth.cs" />
    <Compile Include="../../src/AdaptiveMedia.App/EnhancementDelivery.cs" />
    <Compile Include="../../src/AdaptiveMedia.App/SessionDiagnostics.cs" />
    <Compile Include="../../src/AdaptiveMedia.App/HdrSession.cs" />
    <Compile Include="../../src/AdaptiveMedia.App/NativeDisplay.cs" />
    <Compile Include="../../src/AdaptiveMedia.App/MonitorInventory.cs" />
    <!-- The managed mpv configuration and runtime script, exactly as shipped. -->
    <None Include="../../payload/mpv-config/**" LinkBase="mpv-config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
